, {"id": "v2.ENX-11", "unidade": "ING-E1", "disc": "ING", "frente": "EN → PT: “give way”", "verso": "manobrar para sair do caminho de outro navio", "fonte": "IMO SMCP, Glossary, PDF 21"}, {"id": "v2.ENX-12", "unidade": "ING-E1", "disc": "ING", "frente": "EN → PT: “stand on”", "verso": "manter rumo e velocidade", "fonte": "IMO SMCP, Glossary, PDF 24"}, {"id": "v2.ENX-13", "unidade": "ING-E1", "disc": "ING", "frente": "EN → PT: “course made good”", "verso": "rumo efetivamente feito sobre o fundo", "fonte": "IMO SMCP, Glossary, PDF 19"}, {"id": "v2.ENX-14", "unidade": "ING-E1", "disc": "ING", "frente": "EN → PT: “underway”", "verso": "em movimento: não fundeado, não amarrado e não encalhado", "fonte": "IMO SMCP, Glossary, PDF 25"}, {"id": "v2.ENX-15", "unidade": "ING-E1", "disc": "ING", "frente": "EN → PT: “fairway”", "verso": "parte navegável de uma via", "fonte": "IMO SMCP, Glossary VTS, PDF 25"}, {"id": "v2.ENX-16", "unidade": "ING-E1", "disc": "ING", "frente": "EN → PT: “reporting point”", "verso": "ponto em que o navio deve se reportar ao VTS", "fonte": "IMO SMCP, Glossary VTS, PDF 25"}, {"id": "v2.ENX-17", "unidade": "ING-E1", "disc": "ING", "frente": "EN → PT: “traffic clearance”", "verso": "autorização do VTS para prosseguir em condições especificadas", "fonte": "IMO SMCP, Glossary VTS, PDF 26"}, {"id": "v2.ENX-18", "unidade": "ING-E1", "disc": "ING", "frente": "EN → PT: “veer out (anchor)”", "verso": "largar mais amarra", "fonte": "IMO SMCP, Glossary, PDF 25"}, {"id": "v2.ENX-19", "unidade": "ING-E1", "disc": "ING", "frente": "EN → PT: “walk out (anchor)”", "verso": "arriar o ferro com o molinete até sair do escovém", "fonte": "IMO SMCP, Glossary, PDF 25"}, {"id": "v2.GR-G1.01-1", "unidade": "MAN-01", "disc": "ING", "frente": "G1.01 · Complete com o verbo to be: “The pilot ___ on the bridge.”", "verso": "is", "fonte": "Plano de inglês v1, aula G1.01 — gramática geral; frase criada para o cartão"}, {"id": "v2.GR-G1.01-2", "unidade": "MAN-01", "disc": "ING", "frente": "G1.01 · Complete: “We ___ in the channel.”", "verso": "are", "fonte": "Plano de inglês v1, aula G1.01 — gramática geral; frase criada para o cartão"}, {"id": "v2.GR-G1.02-1", "unidade": "NAR-01", "disc": "ING", "frente": "G1.02 · Passe para a negativa: “The anchor is clear.”", "verso": "The anchor isn't (is not) clear.", "fonte": "Plano de inglês v1, aula G1.02 — gramática geral; frase criada para o cartão"}, {"id": "v2.GR-G1.02-2", "unidade": "NAR-01", "disc": "ING", "frente": "G1.02 · Passe para pergunta: “The pilot is on board.”", "verso": "Is the pilot on board?", "fonte": "Plano de inglês v1, aula G1.02 — gramática geral; frase criada para o cartão"}, {"id": "v2.GR-G1.03-1", "unidade": "AN-01", "disc": "ING", "frente": "G1.03 · there is ou there are? “___ two tugs alongside.”", "verso": "There are (plural).", "fonte": "Plano de inglês v1, aula G1.03 — gramática geral; frase criada para o cartão"}, {"id": "v2.GR-G1.03-2", "unidade": "AN-01", "disc": "ING", "frente": "G1.03 · Preposição: “The tug is ___ the buoys.” (entre)", "verso": "between", "fonte": "Plano de inglês v1, aula G1.03 — gramática geral; frase criada para o cartão"}, {"id": "v2.GR-G1.04-1", "unidade": "LEG-01", "disc": "ING", "frente": "G1.04 · a ou an? “___ anchor”", "verso": "an (som de vogal).", "fonte": "Plano de inglês v1, aula G1.04 — gramática geral; frase criada para o cartão"}, {"id": "v2.GR-G1.04-2", "unidade": "LEG-01", "disc": "ING", "frente": "G1.04 · Plural de “buoy”?", "verso": "buoys", "fonte": "Plano de inglês v1, aula G1.04 — gramática geral; frase criada para o cartão"}, {"id": "v2.GR-G1.05-1", "unidade": "COM-01", "disc": "ING", "frente": "G1.05 · Forma negativa do imperativo usada no SMCP: “___ overtake.”", "verso": "Do not overtake.", "fonte": "SMCP General 4.5 (exemplo “Do not overtake…”), PDF 14"}, {"id": "v2.GR-G1.05-2", "unidade": "COM-01", "disc": "ING", "frente": "G1.05 · No imperativo, o sujeito aparece? Ex.: “Stop engines.”", "verso": "Não: o verbo vem no início, sem sujeito.", "fonte": "Plano de inglês v1, aula G1.05 — gramática geral; frase criada para o cartão"}, {"id": "v2.GR-G1.06-1", "unidade": "MAN-02", "disc": "ING", "frente": "G1.06 · Complete (turn): “The ship ___ to starboard.”", "verso": "turns (3ª pessoa + s).", "fonte": "Plano de inglês v1, aula G1.06 — gramática geral; frase criada para o cartão"}, {"id": "v2.GR-G1.06-2", "unidade": "MAN-02", "disc": "ING", "frente": "G1.06 · Complete (board): “Pilots ___ here.”", "verso": "board (plural, sem s).", "fonte": "Plano de inglês v1, aula G1.06 — gramática geral; frase criada para o cartão"}, {"id": "v2.GR-G1.07-1", "unidade": "NAR-01", "disc": "ING", "frente": "G1.07 · Corrija: “It doesn't turns.”", "verso": "It doesn't turn. (o -s fica no doesn't)", "fonte": "Plano de inglês v1, aula G1.07 — gramática geral; frase criada para o cartão"}, {"id": "v2.GR-G1.07-2", "unidade": "NAR-01", "disc": "ING", "frente": "G1.07 · Negativa de “We have a tug.”", "verso": "We don't (do not) have a tug.", "fonte": "Plano de inglês v1, aula G1.07 — gramática geral; frase criada para o cartão"}, {"id": "v2.GR-G1.08-1", "unidade": "AN-01", "disc": "ING", "frente": "G1.08 · Faça a pergunta: “The vessel has a bow thruster.”", "verso": "Does the vessel have a bow thruster?", "fonte": "Plano de inglês v1, aula G1.08 — gramática geral; frase criada para o cartão"}, {"id": "v2.GR-G1.08-2", "unidade": "AN-01", "disc": "ING", "frente": "G1.08 · Resposta curta afirmativa a “Does she carry dangerous cargo?”", "verso": "Yes, she does.", "fonte": "Plano de inglês v1, aula G1.08 — gramática geral; frase criada para o cartão"}, {"id": "v2.GR-G1.09-1", "unidade": "LEG-02", "disc": "ING", "frente": "G1.09 · Que palavra pergunta LUGAR? “___ is the pilot boat?”", "verso": "Where", "fonte": "Plano de inglês v1, aula G1.09 — gramática geral; frase criada para o cartão"}, {"id": "v2.GR-G1.09-2", "unidade": "LEG-02", "disc": "ING", "frente": "G1.09 · How much ou how many? “___ tugs do you need?”", "vers